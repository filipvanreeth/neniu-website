# Neniu production .htaccess
#
# Target: Apache 2.4 with /web as the DocumentRoot.
# Deploy this file as /web/.htaccess.
# Custom rules must stay outside the WordPress markers: WordPress may replace
# everything between "BEGIN WordPress" and "END WordPress".

# Prevent Apache from exposing directory contents when no index file exists.
Options -Indexes
ServerSignature Off

# Prefer the application front controller for directory requests.
DirectoryIndex index.php

# -----------------------------------------------------------------------------
# MIME types
# -----------------------------------------------------------------------------

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/wasm .wasm
</IfModule>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------

# Brotli is preferred when the module and client both support it.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS \
        text/html \
        text/plain \
        text/css \
        text/javascript \
        text/xml \
        image/svg+xml \
        application/javascript \
        application/json \
        application/ld+json \
        application/manifest+json \
        application/rss+xml \
        application/wasm \
        application/xhtml+xml \
        application/xml
</IfModule>

# Gzip fallback for clients or servers without Brotli support.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html \
        text/plain \
        text/css \
        text/javascript \
        text/xml \
        image/svg+xml \
        application/javascript \
        application/json \
        application/ld+json \
        application/manifest+json \
        application/rss+xml \
        application/wasm \
        application/xhtml+xml \
        application/xml
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching
# -----------------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"

    # Images and media can be cached for a month. This remains safe when a
    # WordPress upload is deliberately replaced at the same URL.
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType audio/ogg "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/ogg "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"

    # Theme assets are versioned by WordPress, so clients may retain them.
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/wasm "access plus 1 month"

    # Font files are effectively immutable assets.
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp|mp3|ogg|mp4|webm|css|js|wasm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(?:eot|otf|ttf|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Safe baseline headers. A Content-Security-Policy is intentionally not set
    # here: it must be tailored to the site's actual scripts and integrations.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always unset X-Powered-By

    # Enable HSTS only after HTTPS works on every intended hostname. Add this in
    # the TLS VirtualHost or uncomment it here when HTTPS terminates at Apache:
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# -----------------------------------------------------------------------------
# Request and WordPress hardening
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # TRACE and TRACK are not required by WordPress.
    RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
    RewriteRule ^ - [R=405,L]

    # Deny hidden files and directories, while preserving ACME validation under
    # /.well-known/ for automated TLS certificate issuance.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

    # Never expose configuration, logs, database dumps, backups or source maps.
    RewriteRule "(^|/)(?:wp-config\.php|php\.ini|\.user\.ini)$" - [F,L,NC]
    RewriteRule "\.(?:bak|conf|dist|fla|inc|ini|log|map|orig|psd|sh|sql|sqlite|swp|ya?ml)(?:~)?$" - [F,L,NC]

    # Block public access to WordPress installation metadata.
    RewriteRule ^wp/(?:license\.txt|readme\.html|wp-config-sample\.php)$ - [F,L,NC]

    # Uploaded files must never be executable PHP. This also catches compound
    # extensions such as image.jpg.php and PHP path-info requests.
    RewriteRule ^app/uploads/.*\.(?:php[0-9]*|pht|phtml|phar|phps)(?:/|$) - [F,L,NC]

    # XML-RPC is not used by this site and is a common brute-force target.
    # Remove this rule if Jetpack, the WordPress mobile app or another XML-RPC
    # integration is introduced.
    RewriteRule ^(?:wp/)?xmlrpc\.php$ - [F,L,NC]

    # Protect PHP implementation files that WordPress does not expose directly.
    # Paths include /wp because this is a Bedrock installation.
    RewriteRule ^wp/wp-admin/includes/ - [F,L,NC]
    RewriteRule ^wp/wp-includes/[^/]+\.php$ - [F,L,NC]
    RewriteRule ^wp/wp-includes/js/tinymce/langs/.+\.php$ - [F,L,NC]
    RewriteRule ^wp/wp-includes/theme-compat/ - [F,L,NC]
</IfModule>

# -----------------------------------------------------------------------------
# WordPress rewrite rules
# -----------------------------------------------------------------------------

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
